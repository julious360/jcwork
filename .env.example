# ── Warehouse (ClickHouse) ────────────────────────────────────────────────────
ADAGENT_CLICKHOUSE__HOST=localhost
ADAGENT_CLICKHOUSE__PORT=8123
ADAGENT_CLICKHOUSE__DATABASE=adagent
ADAGENT_CLICKHOUSE__USER=adagent
ADAGENT_CLICKHOUSE__PASSWORD=adagent
ADAGENT_CLICKHOUSE__SECURE=false

# ── Operational store (Postgres) ──────────────────────────────────────────────
ADAGENT_POSTGRES__DSN=postgresql://adagent:adagent@localhost:5432/adagent

# ── Meta Marketing API (WRITE-ONLY) ───────────────────────────────────────────
# Leave DRY_RUN=true until you have Full Access tier. Nothing is published while true.
ADAGENT_META__DRY_RUN=true
ADAGENT_META__ACCESS_TOKEN=
ADAGENT_META__AD_ACCOUNT_ID=act_000000000000
ADAGENT_META__APP_SECRET=
ADAGENT_META__API_VERSION=v25.0
# "limited" (dev default, 60 pts / 300s) or "full" (post App Review, 9000 pts)
ADAGENT_META__ACCESS_TIER=limited

# ── LLM providers ─────────────────────────────────────────────────────────────
ADAGENT_LLM__ANTHROPIC_API_KEY=
ADAGENT_LLM__GEMINI_API_KEY=
ADAGENT_LLM__TEXT_MODEL=claude-opus-5
ADAGENT_LLM__VISION_MODEL=claude-opus-5
ADAGENT_LLM__IMAGE_MODEL=gemini-2.5-flash-image

# ── Research providers (optional; mock is used when unset) ────────────────────
ADAGENT_RESEARCH__PERPLEXITY_API_KEY=
ADAGENT_RESEARCH__REDDIT_CLIENT_ID=
ADAGENT_RESEARCH__REDDIT_CLIENT_SECRET=
ADAGENT_RESEARCH__REDDIT_USER_AGENT=adagent/0.1

# ── Creative video providers (optional; mock is used when unset) ──────────────
ADAGENT_CREATIVE__HEYGEN_API_KEY=
ADAGENT_CREATIVE__SEEDANCE_API_KEY=

# ── Runtime ───────────────────────────────────────────────────────────────────
ADAGENT_ENVIRONMENT=development
ADAGENT_LOG_LEVEL=INFO
