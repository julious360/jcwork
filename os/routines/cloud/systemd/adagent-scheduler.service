# Enqueues the decision loop every `check_interval_hours` (thresholds.yaml).
[Unit]
Description=adagent loop scheduler
After=network-online.target adagent-worker.service
Wants=network-online.target

[Service]
Type=simple
User=agent
WorkingDirectory=/srv/jcwork
EnvironmentFile=/srv/jcwork/.env
ExecStart=/srv/jcwork/.venv/bin/adagent scheduler
Restart=always
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/jcwork/memory

[Install]
WantedBy=multi-user.target
